---
// Footer.astro — Contact info, legal, and quick links
---

<footer id="contacto" class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand -->
      <div class="footer-brand">
        <img src="/images/logo-fedenaga.png" alt="Logo de FEDENAGA" class="footer-logo" width="160" height="40" />
        <p class="footer-tagline">
          Impulsando la ganadería nacional desde 1962. Representamos y defendemos 
          los intereses de los productores ganaderos de Venezuela.
        </p>
        <div class="footer-social">
          <a href="#" aria-label="FEDENAGA en X (Twitter)" class="social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <a href="#" aria-label="FEDENAGA en Instagram" class="social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </a>
          <a href="#" aria-label="FEDENAGA en Facebook" class="social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Contact -->
      <div class="footer-section">
        <h3>Contacto</h3>
        <ul class="footer-links">
          <li class="footer-contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <span>Av. Urdaneta, Centro Financiero Latino,<br/>Piso 18, La Candelaria, Caracas</span>
          </li>
          <li class="footer-contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
            </svg>
            <span>(0212) 563.2153 / 563.2353</span>
          </li>
          <li class="footer-contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
            <a href="mailto:contacto@fedenaga.org">contacto@fedenaga.org</a>
          </li>
        </ul>
      </div>

      <!-- Quick Links -->
      <div class="footer-section">
        <h3>Enlaces Rápidos</h3>
        <ul class="footer-links">
          <li><a href="#nosotros">Quiénes Somos</a></li>
          <li><a href="#mision-vision">Misión y Visión</a></li>
          <li><a href="#servicios">Servicios Comerciales</a></li>
          <li><a href="#contacto">Contacto</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div class="footer-section">
        <h3>Información Legal</h3>
        <ul class="footer-links">
          <li><a href="#">Política de Privacidad</a></li>
          <li><a href="#">Términos de Servicio</a></li>
          <li><a href="#">Aviso Legal</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; 2026 FEDENAGA — Federación Nacional de Ganaderos de Venezuela.</p>
      <p class="footer-wcag">Desarrollado bajo estándares WCAG de accesibilidad.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--text-dark);
    color: rgba(255, 255, 255, 0.85);
    padding: var(--space-3xl) 0 0;
    margin-top: var(--space-3xl);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 0.8fr 0.8fr;
    gap: var(--space-2xl);
    padding-bottom: var(--space-2xl);
  }

  .footer-logo {
    height: 36px;
    width: auto;
    filter: brightness(0) invert(1);
    margin-bottom: var(--space-md);
  }

  .footer-tagline {
    font-size: var(--font-size-sm);
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.7;
    margin-bottom: var(--space-lg);
    max-width: 300px;
  }

  .footer-social {
    display: flex;
    gap: var(--space-sm);
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.7);
    transition: all var(--transition-base);
  }

  .social-link:hover {
    background: var(--primary);
    color: var(--white);
    transform: translateY(-2px);
  }

  .footer-section h3 {
    font-size: var(--font-size-sm);
    font-weight: 700;
    color: var(--white);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-lg);
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-links li,
  .footer-links a {
    font-size: var(--font-size-sm);
    color: rgba(255, 255, 255, 0.6);
    transition: color var(--transition-fast);
    line-height: 1.6;
  }

  .footer-links a:hover {
    color: var(--white);
  }

  .footer-contact-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .footer-contact-item svg {
    margin-top: 3px;
    flex-shrink: 0;
    color: var(--primary);
    opacity: 0.8;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: var(--space-lg) 0;
    text-align: center;
  }

  .footer-bottom p {
    font-size: var(--font-size-sm);
    color: rgba(255, 255, 255, 0.4);
    margin: 0;
  }

  .footer-wcag {
    margin-top: var(--space-xs) !important;
    font-size: var(--font-size-xs) !important;
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .footer-tagline {
      max-width: 100%;
    }
  }
</style>
